#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
mdshow :: buildall — 构建入口（mdshow-slides skill 版）
受南京大学蒋炎岩（jyy）老师课程幻灯片工作流启发；零依赖，纯 Python 标准库。

用法（在本 skill 目录内或任意工作目录）:
  python3 assets/engine/buildall 讲稿.md -o build/slides.html
  python3 assets/engine/buildall 讲稿.md --dry-run
  python3 assets/engine/buildall 讲稿.md -o out.html --theme references/themes/theme-v3-paper-journal.css
"""
import argparse
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent          # .../assets/engine
SKILL = HERE.parents[1]                                  # .../mdshow-slides/
sys.path.insert(0, str(HERE))

from slideshow import parser, render  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="buildall", description="Markdown 讲稿 -> 单文件 HTML 放映稿")
    ap.add_argument("source", help="讲稿 Markdown 路径")
    ap.add_argument("-o", "--output", default="build/slides.html", help="输出 HTML 路径")
    ap.add_argument("--dry-run", action="store_true", help="只解析检查，不写出文件")
    ap.add_argument("--theme",
                    default=str(SKILL / "references/themes/theme-v2-zitan.css"),
                    help="主题 CSS（构建时内联；默认 v2 紫檀）")
    ap.add_argument("--runtime", default=str(HERE / "slideshow/runtime.js"),
                    help="放映 JS（构建时内联，一般无需改动）")
    args = ap.parse_args()

    src = pathlib.Path(args.source)
    if not src.exists():
        print(f"[error] 讲稿不存在: {src}", file=sys.stderr)
        return 2
    text = src.read_text(encoding="utf-8")

    try:
        slides, placeholders, dialect_b = parser.parse(text)
    except ValueError as e:
        print(f"[error] {src}: {e}", file=sys.stderr)
        return 2

    dialect_name = "B" if dialect_b else "A"
    dialect_desc = "--- 分页 / make-slides 产物" if dialect_b else "## 分页 / 人类讲稿"
    print(f"[build] 方言 {dialect_name}（{dialect_desc}）")

    # [[...]] 图片占位符 -> 控制台警告（提示后续补图/生成图）
    for p in placeholders:
        print(f"[warn] {src}:{p['line']} 图片占位符「{p['text']}」-> 已渲染为虚线占位卡，请替换为真实图片",
              file=sys.stderr)

    n_frag = parser.count_fragments(slides)
    print(f"[build] {src}: {len(slides)} 页 / {n_frag} 个分步元素 / {len(placeholders)} 个图片占位")

    if args.dry_run:
        for i, s in enumerate(slides, 1):
            kind = "封面" if s.level == 1 else "内容"
            print(f"       - 第 {i} 页 [{kind}] {s.title or '(无标题)'}")
        print("[dry-run] 检查通过，未写出文件。")
        return 0

    theme_path = pathlib.Path(args.theme)
    runtime_path = pathlib.Path(args.runtime)
    theme_css = theme_path.read_text(encoding="utf-8") if theme_path.exists() else ""
    runtime_js = runtime_path.read_text(encoding="utf-8") if runtime_path.exists() else ""

    html = render.render(slides, theme_css, runtime_js)
    out = pathlib.Path(args.output)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(html, encoding="utf-8")
    print(f"[ ok ] 写出 {out}（{out.stat().st_size / 1024:.1f} KB，单文件，直接双击放映）")
    return 0


if __name__ == "__main__":
    sys.exit(main())
